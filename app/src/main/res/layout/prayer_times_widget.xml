<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_prayer_widget"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="5dp"
    android:paddingEnd="10dp"
    android:paddingBottom="5dp">

    <!-- Top Row: Mosque Icon & Hijri Date (Location shifted to Next Prayer tile) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_mosque"
            android:tint="@color/prayer_widget_gold" />

        <TextView
            android:id="@+id/prayer_hijri_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="15 Ramadan 1447 AH"
            android:textColor="@color/prayer_widget_gold"
            android:textSize="@dimen/prayer_widget_hijri_text_size" />
    </LinearLayout>

    <!-- Hero Card: Next Prayer & (Location • Sunrise) -->
    <LinearLayout
        android:id="@+id/prayer_hero_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.5dp"
        android:background="@drawable/bg_prayer_hero"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="3.5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3.5dp">

        <TextView
            android:id="@+id/prayer_next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Next Asr in 2h 15m"
            android:textColor="@color/prayer_widget_text"
            android:textSize="@dimen/prayer_widget_next_label_text_size"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/prayer_countdown"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0.5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/prayer_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="London, UK"
                android:textColor="@color/prayer_widget_secondary"
                android:textSize="@dimen/prayer_widget_location_text_size" />

            <TextView
                android:id="@+id/prayer_sunrise_bullet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  •  "
                android:textColor="@color/prayer_widget_secondary"
                android:textSize="@dimen/prayer_widget_sunrise_text_size" />

            <TextView
                android:id="@+id/prayer_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Sunrise: 06:12"
                android:textColor="@color/prayer_widget_secondary"
                android:textSize="@dimen/prayer_widget_sunrise_text_size" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 1: 5 Obligatory Prayer Slots -->
    <LinearLayout
        android:id="@+id/prayer_slots_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.5dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/slot_fajr"
            style="@style/PrayerWidgetSlot">

            <TextView
                android:id="@+id/name_fajr"
                style="@style/PrayerWidgetSlotName"
                android:text="Fajr" />

            <TextView
                android:id="@+id/time_fajr"
                style="@style/PrayerWidgetSlotTime"
                android:text="05:15" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_dhuhr"
            style="@style/PrayerWidgetSlot">

            <TextView
                android:id="@+id/name_dhuhr"
                style="@style/PrayerWidgetSlotName"
                android:text="Dhuhr" />

            <TextView
                android:id="@+id/time_dhuhr"
                style="@style/PrayerWidgetSlotTime"
                android:text="12:30" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_asr"
            style="@style/PrayerWidgetSlot">

            <TextView
                android:id="@+id/name_asr"
                style="@style/PrayerWidgetSlotName"
                android:text="Asr" />

            <TextView
                android:id="@+id/time_asr"
                style="@style/PrayerWidgetSlotTime"
                android:text="15:45" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_maghrib"
            style="@style/PrayerWidgetSlot">

            <TextView
                android:id="@+id/name_maghrib"
                style="@style/PrayerWidgetSlotName"
                android:text="Maghrib" />

            <TextView
                android:id="@+id/time_maghrib"
                style="@style/PrayerWidgetSlotTime"
                android:text="18:10" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_isha"
            style="@style/PrayerWidgetSlot">

            <TextView
                android:id="@+id/name_isha"
                style="@style/PrayerWidgetSlotName"
                android:text="Isha" />

            <TextView
                android:id="@+id/time_isha"
                style="@style/PrayerWidgetSlotTime"
                android:text="19:35" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: 4 Nafil Prayer Slots (Ishraq, Chasht, Awwabin, Tahajjud) -->
    <LinearLayout
        android:id="@+id/prayer_nafil_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.5dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/slot_ishraq"
            style="@style/PrayerWidgetNafilSlot">

            <TextView
                android:id="@+id/name_ishraq"
                style="@style/PrayerWidgetNafilSlotName"
                android:text="Ishraq" />

            <TextView
                android:id="@+id/time_ishraq"
                style="@style/PrayerWidgetNafilSlotTime"
                android:text="07:12 am" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_chasht"
            style="@style/PrayerWidgetNafilSlot">

            <TextView
                android:id="@+id/name_chasht"
                style="@style/PrayerWidgetNafilSlotName"
                android:text="Chasht" />

            <TextView
                android:id="@+id/time_chasht"
                style="@style/PrayerWidgetNafilSlotTime"
                android:text="09:26 am" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_awwabin"
            style="@style/PrayerWidgetNafilSlot">

            <TextView
                android:id="@+id/name_awwabin"
                style="@style/PrayerWidgetNafilSlotName"
                android:text="Awwabin" />

            <TextView
                android:id="@+id/time_awwabin"
                style="@style/PrayerWidgetNafilSlotTime"
                android:text="05:08 pm" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_tahajjud"
            style="@style/PrayerWidgetNafilSlot">

            <TextView
                android:id="@+id/name_tahajjud"
                style="@style/PrayerWidgetNafilSlotName"
                android:text="Tahajjud" />

            <TextView
                android:id="@+id/time_tahajjud"
                style="@style/PrayerWidgetNafilSlotTime"
                android:text="02:16 am" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
