<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_prayer_widget"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Top Row: Mosque Icon + City / Location & Hijri Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_mosque"
            android:tint="@color/prayer_widget_gold" />

        <TextView
            android:id="@+id/prayer_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="London, UK"
            android:textColor="@color/prayer_widget_text"
            android:textSize="@dimen/prayer_widget_location_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/prayer_hijri_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="15 Ramadan 1447 AH"
            android:textColor="@color/prayer_widget_gold"
            android:textSize="@dimen/prayer_widget_hijri_text_size" />
    </LinearLayout>

    <!-- Hero Card: Next Prayer Countdown, Sunrise & LIVE Badge -->
    <LinearLayout
        android:id="@+id/prayer_hero_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_prayer_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/prayer_next_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Next Asr in "
                    android:textColor="@color/prayer_widget_text"
                    android:textSize="@dimen/prayer_widget_next_label_text_size"
                    android:textStyle="bold" />

                <Chronometer
                    android:id="@+id/prayer_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="02:14:32"
                    android:textColor="@color/prayer_widget_text"
                    android:textSize="@dimen/prayer_widget_countdown_text_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/prayer_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="Sunrise: 06:12"
                android:textColor="@color/prayer_widget_secondary"
                android:textSize="@dimen/prayer_widget_sunrise_text_size" />
        </LinearLayout>

        <TextView
            android:id="@+id/prayer_live_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_prayer_live_badge"
            android:fontFamily="sans-serif-black"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="LIVE"
            android:textColor="@color/prayer_live_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Row: 5 Prayer Timetable Slots -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/slot_fajr"
            style="@style/PrayerWidgetSlot">

            <TextView
                android:id="@+id/name_fajr"
                style="@style/PrayerWidgetSlotName"
                android:text="Fajr" />

            <TextView
                android:id="@+id/time_fajr"
                style="@style/PrayerWidgetSlotTime"
                android:text="05:15" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_dhuhr"
            style="@style/PrayerWidgetSlot">

            <TextView
                android:id="@+id/name_dhuhr"
                style="@style/PrayerWidgetSlotName"
                android:text="Dhuhr" />

            <TextView
                android:id="@+id/time_dhuhr"
                style="@style/PrayerWidgetSlotTime"
                android:text="12:30" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_asr"
            style="@style/PrayerWidgetSlot"
            android:background="@drawable/bg_prayer_slot_active">

            <TextView
                android:id="@+id/name_asr"
                style="@style/PrayerWidgetSlotName"
                android:text="Asr" />

            <TextView
                android:id="@+id/time_asr"
                style="@style/PrayerWidgetSlotTime"
                android:text="15:45" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_maghrib"
            style="@style/PrayerWidgetSlot">

            <TextView
                android:id="@+id/name_maghrib"
                style="@style/PrayerWidgetSlotName"
                android:text="Maghrib" />

            <TextView
                android:id="@+id/time_maghrib"
                style="@style/PrayerWidgetSlotTime"
                android:text="18:10" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_isha"
            style="@style/PrayerWidgetSlot">

            <TextView
                android:id="@+id/name_isha"
                style="@style/PrayerWidgetSlotName"
                android:text="Isha" />

            <TextView
                android:id="@+id/time_isha"
                style="@style/PrayerWidgetSlotTime"
                android:text="19:35" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
