<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_prayer_widget"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/prayer_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:visibility="gone"
        android:text="Islamabad, Pakistan"
        android:textColor="@color/prayer_widget_text"
        android:textSize="@dimen/prayer_widget_location_text_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/prayer_hijri_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="17 Rabi al-Awwal 1448"
            android:textColor="@color/prayer_widget_secondary"
            android:textSize="@dimen/prayer_widget_hijri_text_size" />

        <TextView
            android:id="@+id/prayer_sunrise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:drawablePadding="3dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Sunrise 5:40"
            android:textColor="@color/prayer_widget_secondary"
            android:textSize="@dimen/prayer_widget_sunrise_text_size" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/slot_fajr"
            style="@style/PrayerWidgetSlot">

            <TextView
                android:id="@+id/name_fajr"
                style="@style/PrayerWidgetSlotName"
                android:text="Fajr" />

            <TextView
                android:id="@+id/time_fajr"
                style="@style/PrayerWidgetSlotTime"
                android:text="4:13" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_dhuhr"
            style="@style/PrayerWidgetSlot">

            <TextView
                android:id="@+id/name_dhuhr"
                style="@style/PrayerWidgetSlotName"
                android:text="Dhuhr" />

            <TextView
                android:id="@+id/time_dhuhr"
                style="@style/PrayerWidgetSlotTime"
                android:text="12:08" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_asr"
            style="@style/PrayerWidgetSlot"
            android:background="@drawable/bg_prayer_slot_active">

            <TextView
                android:id="@+id/name_asr"
                style="@style/PrayerWidgetSlotName"
                android:text="Asr" />

            <TextView
                android:id="@+id/time_asr"
                style="@style/PrayerWidgetSlotTime"
                android:text="3:47" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_maghrib"
            style="@style/PrayerWidgetSlot">

            <TextView
                android:id="@+id/name_maghrib"
                style="@style/PrayerWidgetSlotName"
                android:text="Maghrib" />

            <TextView
                android:id="@+id/time_maghrib"
                style="@style/PrayerWidgetSlotTime"
                android:text="6:36" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot_isha"
            style="@style/PrayerWidgetSlot">

            <TextView
                android:id="@+id/name_isha"
                style="@style/PrayerWidgetSlotName"
                android:text="Isha" />

            <TextView
                android:id="@+id/time_isha"
                style="@style/PrayerWidgetSlotTime"
                android:text="8:03" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/prayer_next_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Next Asr in"
            android:textColor="@color/prayer_widget_secondary"
            android:textSize="@dimen/prayer_widget_next_label_text_size" />

        <Chronometer
            android:id="@+id/prayer_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="02:14:32"
            android:textColor="@color/prayer_widget_accent"
            android:textSize="@dimen/prayer_widget_countdown_text_size" />
    </LinearLayout>
</LinearLayout>
